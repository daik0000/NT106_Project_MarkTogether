# Copy file này thành /etc/marktogether/env trên VPS APP.
# Quyền khuyến nghị:
#   sudo chown root:marktogether /etc/marktogether/env
#   sudo chmod 640 /etc/marktogether/env

MARKTOGETHER_PORT=5000
MARKTOGETHER_STORAGE_PATH=/opt/marktogether/storage

# PostgreSQL production connection for 2-server deployment.
# PostgreSQL runs on DB VPS 67.205.130.221 and the app runs on App VPS 159.203.184.87.
# DB password phải trùng MARKTOGETHER_DB_PASSWORD trong /opt/marktogether/app/.env trên DB VPS.
MARKTOGETHER_DB_CONNECTION=Host=67.205.130.221;Port=5432;Database=marktogether_db;Username=marktogether_user;Password=CHANGE_ME_STRONG_PASSWORD

# Redis shared session store (optional nhưng bắt buộc nếu chạy nhiều app server sau LB).
# Ví dụ: MARKTOGETHER_REDIS_CONNECTION=67.205.130.221:6379,password=CHANGE_ME,ssl=false,abortConnect=false
MARKTOGETHER_REDIS_CONNECTION=

# TTL token session trong Redis (giây). Mặc định 86400 nếu để trống.
MARKTOGETHER_SESSION_TTL_SECONDS=86400

# Gemini key nếu bật AI. Để trống nếu không dùng AI.
MARKTOGETHER_GEMINI_KEY=
